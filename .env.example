# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only service_role key, used to store the community AI suggestion.
# Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# ElevenLabs voice (free tier works). Leave blank to fall back to the browser's built-in voice.
ELEVENLABS_API_KEY=
# Optional: a default voice id usable on the free plan (default: Sarah)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# n8n vet booking workflow (optional). Leave blank to save requests without sending them.
# Production webhook URL of your n8n "Webhook" trigger node.
N8N_BOOKING_WEBHOOK_URL=
# Shared secret: sent to n8n as X-PawPal-Secret, and required on /api/booking/callback.
N8N_WEBHOOK_SECRET=
